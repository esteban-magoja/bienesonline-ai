APP_NAME=Wave
APP_ENV=local
APP_KEY=base64:8dQ7xw/kM9EYMV4cUkzKgET8jF4P0M0TOmmqN05RN2w=
APP_DEBUG=true
APP_URL=http://localhost

# Dominios permitidos (separados por comas, ejemplo: tudominio.com,www.tudominio.com)
ALLOWED_DOMAINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=database
#DB_USERNAME=root
#DB_PASSWORD=
#DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=9999
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=SeCrEtKeY

WAVE_DEMO=false

# Add the Google Analytics Property ID (instructions can be found here: https://github.com/spatie/laravel-analytics)
ANALYTICS_PROPERTY_ID=ID_NUM

# BILLING CREDENTIALS
BILLING_PROVIDER=stripe

PADDLE_VENDOR_ID=999
PADDLE_API_KEY=999
PADDLE_ENV=sandbox
PADDLE_PUBLIC_KEY=test_...
PADDLE_WEBHOOK_SECRET=pdl_...

STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# Matching Automático - Notificaciones
# ============================================================================
AUTO_MATCHING_ENABLED=true
MATCHING_MIN_SCORE=70
MATCHING_MAX_MATCHES=20
MATCHING_NOTIFICATION_DELAY=0
MATCHING_MAX_NOTIFICATIONS_PER_DAY=
MATCHING_MAX_NOTIFICATIONS_PER_HOUR=
MATCHING_LOGGING_ENABLED=true
MATCHING_LOG_LEVEL=info

# Importación desde proyecto legacy
# Importación desde proyecto legacy (agregar URL por país según corresponda)
LEGACY_URL_AR=
LEGACY_URL_MX=
LEGACY_URL_CL=
LEGACY_URL_ES=
LEGACY_URL_CO=
LEGACY_URL_UY=
IMPORT_API_TIMEOUT=30
IMPORT_IMAGE_TIMEOUT=60
IMPORT_SOURCE_NAME=legacy

# ============================================================================
# WhatsApp Business (Meta Cloud API)
# ============================================================================
# Activar/desactivar envío de mensajes WhatsApp
WHATSAPP_ENABLED=false

# Token de acceso del sistema (System User Token) - Meta Business Suite
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de negocio (WhatsApp Business Account ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Versión de la Meta Graph API
WHATSAPP_API_VERSION=v19.0

# Nombres de los templates aprobados en Meta Business Suite
WHATSAPP_WELCOME_TEMPLATE_ES=bienvenida
WHATSAPP_WELCOME_TEMPLATE_EN=welcome
WHATSAPP_WELCOME_LANGUAGE_ES=es
WHATSAPP_WELCOME_LANGUAGE_EN=en

# Habilitar logging de mensajes enviados
WHATSAPP_LOGGING=true
